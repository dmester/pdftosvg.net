<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <!-- Force the scalar code paths by disabling all hardware intrinsics. -->
      <DOTNET_EnableHWIntrinsic>0</DOTNET_EnableHWIntrinsic>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
